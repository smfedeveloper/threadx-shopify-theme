<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_background }}">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,500&family=Manrope:wght@400;500;600;700&display=swap" rel="stylesheet">
    <title>{% if page_title != blank %}{{ page_title }} · {% endif %}{{ shop.name }}</title>
    {% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
    {{ content_for_header }}
    {{ 'theme.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>
  </head>
  <body>
    <a class="skip-link" href="#MainContent">Skip to content</a>
    {% section 'header' %}
    <main id="MainContent" tabindex="-1">{{ content_for_layout }}</main>
    {% section 'footer' %}
    <dialog class="quick-view" id="QuickViewDialog" aria-label="Product quick view">
      <button class="quick-view__close" type="button" data-quick-view-close aria-label="Close quick view">×</button>
      <div data-quick-view-content></div>
    </dialog>
    <dialog class="cart-drawer" id="CartDrawer" aria-labelledby="CartDrawerTitle">
      <div class="cart-drawer__header">
        <div>
          <p class="eyebrow">Your selection</p>
          <h2 id="CartDrawerTitle">Shopping bag <span data-cart-drawer-count>({{ cart.item_count }})</span></h2>
        </div>
        <button class="cart-drawer__close" type="button" data-cart-close aria-label="Close shopping bag">&times;</button>
      </div>
      <div class="cart-drawer__status" data-cart-status role="status" aria-live="polite"></div>
      <div class="cart-drawer__items" data-cart-items></div>
      <div class="cart-drawer__footer" data-cart-footer hidden>
        <div class="cart-drawer__subtotal">
          <span>Subtotal</span>
          <strong data-cart-subtotal>{{ cart.total_price | money }}</strong>
        </div>
        <p>Taxes and shipping calculated at checkout.</p>
        <form action="{{ routes.cart_url }}" method="post">
          <button class="buy-button" type="submit" name="checkout">Checkout <span>&rarr;</span></button>
        </form>
        <a class="underlined" href="{{ routes.cart_url }}">View shopping bag <span>&nearr;</span></a>
      </div>
    </dialog>
  </body>
</html>
