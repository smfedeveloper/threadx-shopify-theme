<section class="main-product section-shell" data-product-section>
  <div class="product-gallery" data-product-gallery>
    <div class="product-gallery__stage">
      {% for media in product.media %}
        <figure class="product-gallery__item{% if forloop.first %} is-active{% endif %}" data-gallery-slide data-media-id="{{ media.id }}" {% unless forloop.first %}hidden{% endunless %}>
          {% if media.media_type == 'image' %}
            {% assign media_alt = media.alt | default: product.title %}
            {{ media | image_url: width: 1800 | image_tag: widths: '600,900,1200,1800', sizes: '(min-width: 900px) 60vw, 100vw', loading: 'lazy', alt: media_alt }}
          {% else %}
            {{ media | media_tag: image_size: '1200x', controls: true }}
          {% endif %}
        </figure>
      {% else %}
        {{ 'product-1' | placeholder_svg_tag: 'placeholder' }}
      {% endfor %}
      {% if product.media.size > 1 %}
        <button class="gallery-arrow gallery-arrow--previous" type="button" data-gallery-previous aria-label="Previous product image">&#8592;</button>
        <button class="gallery-arrow gallery-arrow--next" type="button" data-gallery-next aria-label="Next product image">&#8594;</button>
      {% endif %}
    </div>
    {% if product.media.size > 1 %}
      <div class="product-gallery__thumbnails" role="tablist" aria-label="Product images">
        {% for media in product.media %}
          <button class="product-gallery__thumbnail{% if forloop.first %} is-active{% endif %}" type="button" data-gallery-thumbnail data-slide-index="{{ forloop.index0 }}" aria-label="View image {{ forloop.index }} of {{ product.media.size }}" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}">
            {{ media.preview_image | image_url: width: 180 | image_tag: widths: '90,120,180', sizes: '80px', loading: 'lazy', alt: '' }}
          </button>
        {% endfor %}
      </div>
    {% endif %}
  </div>
  <div class="product-details">
    <p class="eyebrow">{{ product.vendor }}{% if product.type != blank %} · {{ product.type }}{% endif %}</p>
    {% assign current_variant = product.selected_or_first_available_variant %}
    <div class="product-title-row">
      <h1>{{ product.title }}</h1>
      <div class="product-prices">
        <span class="product-price" data-product-price>{{ current_variant.price | money }}</span>
        <s class="product-compare-price" data-product-compare-price{% unless current_variant.compare_at_price > current_variant.price %} hidden{% endunless %}>
          {% if current_variant.compare_at_price > current_variant.price %}{{ current_variant.compare_at_price | money }}{% endif %}
        </s>
      </div>
    </div>
    <div class="product-description rte">{{ product.description }}</div>

    {% form 'product', product, class: 'product-form', data-product-form: '' %}
      {% unless product.has_only_default_variant %}
        {% for option in product.options_with_values %}
          <fieldset class="option-picker">
            <legend>{{ option.name }}</legend>
            {% assign option_name = option.name | downcase %}
            {% if option_name contains 'size' %}
              <button class="size-guide-trigger" type="button" data-size-guide-open aria-controls="SizeGuide-{{ section.id }}">View size guide</button>
            {% endif %}
            <div class="option-values">
              {% for value in option.values %}
                <label>
                  <input type="radio" name="options[{{ option.name | escape }}]" value="{{ value | escape }}" {% if option.selected_value == value %}checked{% endif %}>
                  <span>{{ value }}</span>
                </label>
              {% endfor %}
            </div>
          </fieldset>
        {% endfor %}
      {% endunless %}
      <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" data-variant-id>
      <label class="quantity-label" for="Quantity-{{ section.id }}">Quantity</label>
      <input class="quantity-input" id="Quantity-{{ section.id }}" type="number" name="quantity" value="1" min="1">
      <button class="buy-button" type="submit" {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %} data-add-to-cart>
        {% if product.selected_or_first_available_variant.available %}{{ 'products.add_to_cart' | t }}{% else %}{{ 'products.sold_out' | t }}{% endif %} <span>→</span>
      </button>
      {{ form | payment_button }}
      <p class="form-message" data-form-message role="status"></p>
    {% endform %}

    <div class="product-assurances">
      <div><strong>Premium fabrication</strong><span>Considered materials and enduring construction.</span></div>
      <div><strong>Complimentary delivery</strong><span>Available on launch collection orders.</span></div>
      <div><strong>Secure checkout</strong><span>Protected payments through Shopify.</span></div>
    </div>
  </div>
  <script type="application/json" data-product-json>{{ product.variants | json }}</script>
</section>

{% assign product_type = product.type | downcase %}
{% assign is_tshirt = false %}
{% if product_type contains 't-shirt' or product_type contains 'tshirt' or product_type contains 'tee' or product_type contains 'shirt' %}
  {% assign is_tshirt = true %}
{% endif %}
<dialog class="size-guide" id="SizeGuide-{{ section.id }}" aria-labelledby="SizeGuideTitle-{{ section.id }}">
  <button class="size-guide__close" type="button" data-size-guide-close aria-label="Close size guide">&times;</button>
  <p class="eyebrow">Find your fit</p>
  <h2 id="SizeGuideTitle-{{ section.id }}">{% if is_tshirt %}T-shirt{% else %}Tracksuit{% endif %} size guide</h2>
  <p class="size-guide__intro">Use your body measurements to choose the best size. Measurements are shown in inches.</p>
  <div class="size-guide__table-wrap">
    {% if is_tshirt %}
      <table>
        <caption class="visually-hidden">ThreadX T-shirt size measurements</caption>
        <thead><tr><th>Size</th><th>Chest</th><th>Waist</th><th>Garment length</th></tr></thead>
        <tbody>
          <tr><th>S</th><td>36–38</td><td>30–32</td><td>27</td></tr>
          <tr><th>M</th><td>39–41</td><td>33–35</td><td>28</td></tr>
          <tr><th>L</th><td>42–44</td><td>36–38</td><td>29</td></tr>
          <tr><th>XL</th><td>45–47</td><td>39–41</td><td>30</td></tr>
        </tbody>
      </table>
      <p class="size-guide__note"><strong>Fit:</strong> A structured regular fit. Choose one size up for a relaxed silhouette.</p>
    {% else %}
      <table>
        <caption class="visually-hidden">ThreadX tracksuit size measurements</caption>
        <thead><tr><th>Size</th><th>Chest</th><th>Waist</th><th>Inside leg</th></tr></thead>
        <tbody>
          <tr><th>S</th><td>36–38</td><td>30–32</td><td>29</td></tr>
          <tr><th>M</th><td>39–41</td><td>33–35</td><td>30</td></tr>
          <tr><th>L</th><td>42–44</td><td>36–38</td><td>31</td></tr>
          <tr><th>XL</th><td>45–47</td><td>39–41</td><td>32</td></tr>
        </tbody>
      </table>
      <p class="size-guide__note"><strong>Fit:</strong> True to size with a tapered leg. Choose one size up for a more relaxed fit.</p>
    {% endif %}
  </div>
  <p class="size-guide__help">Measure around the fullest part of your chest and your natural waist. If you fall between sizes, choose the larger size.</p>
</dialog>

{% schema %}
{
  "name": "Main product",
  "settings": []
}
{% endschema %}
