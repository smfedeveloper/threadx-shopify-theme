{% liquid
  assign hero_image = section.settings.image | default: collection.image
  assign hero_heading = section.settings.heading | default: collection.title
  assign hero_subheading = section.settings.subheading
  assign hero_alt = hero_image.alt | default: hero_heading

  if hero_subheading == blank
    assign hero_subheading = collection.metafields.custom.hero_subheading.value
  endif
%}

<section class="collection-banner{% if hero_image == blank %} collection-banner--no-image{% endif %}">
  {% if hero_image != blank %}
    {{
      hero_image
      | image_url: width: 2400
      | image_tag:
        class: 'collection-banner__image',
        widths: '750, 1100, 1500, 2000, 2400',
        sizes: '100vw',
        loading: 'eager',
        fetchpriority: 'high',
        alt: hero_alt
    }}
  {% endif %}

  <div class="collection-banner__shade" aria-hidden="true"></div>

  <div class="collection-banner__content page-width">
    {% if section.settings.eyebrow != blank %}
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
    {% endif %}
    <h1>{{ hero_heading }}</h1>
    {% if hero_subheading != blank %}
      <p class="collection-banner__subheading">{{ hero_subheading }}</p>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Collection hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image override",
      "info": "Leave blank to use this collection's image."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "ThreadX collection"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Leave blank to use the collection title."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "info": "Leave blank to use the collection metafield custom.hero_subheading."
    }
  ],
  "presets": [
    {
      "name": "Collection hero"
    }
  ]
}
{% endschema %}
