{% liquid
  assign hero_image = collection.metafields.custom.hero_image.value
  if hero_image == blank
    assign hero_image = section.settings.image
  endif
  if hero_image == blank
    assign hero_image = collection.image
  endif
  if hero_image == blank
    assign hero_image = collection.products.first.featured_image
  endif

  assign hero_eyebrow = collection.metafields.custom.hero_eyebrow.value
  if hero_eyebrow == blank
    assign hero_eyebrow = section.settings.eyebrow
  endif

  assign hero_heading = collection.metafields.custom.hero_heading.value
  if hero_heading == blank
    assign hero_heading = section.settings.heading
  endif
  if hero_heading == blank
    assign hero_heading = collection.title
  endif

  assign hero_subheading = collection.metafields.custom.hero_subheading.value
  if hero_subheading == blank
    assign hero_subheading = section.settings.subheading
  endif

  assign hero_alt = hero_image.alt | default: hero_heading
%}

<section class="collection-banner{% if hero_image == blank %} collection-banner--no-image{% endif %}">
  {% if hero_image != blank %}
    {{
      hero_image
      | image_url: width: 2400
      | image_tag:
        class: 'collection-banner__image',
        widths: '750, 1100, 1500, 2000, 2400',
        sizes: '100vw',
        loading: 'eager',
        fetchpriority: 'high',
        alt: hero_alt
    }}
  {% endif %}

  <div class="collection-banner__shade" aria-hidden="true"></div>

  <div class="collection-banner__content page-width">
    {% if hero_eyebrow != blank %}
      <p class="eyebrow">{{ hero_eyebrow }}</p>
    {% endif %}
    <h1>{{ hero_heading }}</h1>
    {% if hero_subheading != blank %}
      <p class="collection-banner__subheading">{{ hero_subheading }}</p>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Collection hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Default image",
      "info": "Per-collection hero image, collection image, and first product image take priority."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Default eyebrow",
      "default": "ThreadX collection"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Default heading",
      "info": "Leave blank to use each collection title."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Default subheading",
      "info": "Used when a collection has no custom.hero_subheading metafield value."
    }
  ],
  "presets": [
    {
      "name": "Collection hero"
    }
  ]
}
{% endschema %}
