<section class="featured-collection section-shell{% if section.settings.dark %} featured-collection--dark{% endif %}">
  <div class="section-heading">
    <div>
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      <h2>{{ section.settings.heading }}</h2>
      {% if section.settings.description != blank %}<p class="section-description">{{ section.settings.description }}</p>{% endif %}
    </div>
    {% if section.settings.collection != blank %}<a class="underlined" href="{{ section.settings.collection.url }}">View collection <span>↗</span></a>{% endif %}
  </div>
  <div class="product-grid">
    {% if section.settings.collection != blank %}
      {% for product in section.settings.collection.products limit: section.settings.products_to_show %}
        {% render 'product-card', product: product %}
      {% else %}
        <p>No products found in this collection.</p>
      {% endfor %}
    {% else %}
      {% for i in (1..3) %}
        <article class="product-card product-card--placeholder">
          {{ 'product-' | append: i | placeholder_svg_tag: 'product-card__image placeholder' }}
          <div class="product-card__info"><h3>Choose a collection</h3></div>
        </article>
      {% endfor %}
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The collection" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The essentials" },
    { "type": "textarea", "id": "description", "label": "Description" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 3, "max": 12, "step": 3, "default": 6 },
    { "type": "checkbox", "id": "dark", "label": "Dark style", "default": false }
  ],
  "presets": [{ "name": "Featured collection" }]
}
{% endschema %}
