<section class="newsletter section-shell">
  <p class="eyebrow">{{ section.settings.eyebrow }}</p>
  <h2>{{ section.settings.heading }}</h2>
  <p>{{ section.settings.text }}</p>
  {% form 'customer', class: 'newsletter-form' %}
    <input type="hidden" name="contact[tags]" value="newsletter">
    <label class="visually-hidden" for="NewsletterEmail-{{ section.id }}">Email address</label>
    <input id="NewsletterEmail-{{ section.id }}" type="email" name="contact[email]" value="{{ form.email }}" placeholder="Email address" required>
    <button type="submit">Join <span>→</span></button>
    {% if form.posted_successfully? %}<p>Thank you for joining.</p>{% endif %}
    {{ form.errors | default_errors }}
  {% endform %}
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Private access" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Join the world of ThreadX." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "New collections, considered stories and private releases—delivered with restraint." }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
